---
// The ETAF landing page.  It is a standalone page rather than a Starlight
// splash: the manual keeps Starlight's reading layout, while the landing owns
// its whole design.  The color theme follows the manual's stored choice
// (`starlight-theme`), so switching on either side carries over.
import { landing } from '../data/landing.mjs';
import mark from '../assets/etaf-icon.svg';

interface Props { language: 'en' | 'zh' }
const { language } = Astro.props;
const t = landing(language);
const pick = (name: string) => t.apps.find((app) => app.name === name)!;
const [heroFront, heroLeft, heroRight] = ['etaf-ncm', 'etaf-weread', 'etaf-telega'].map(pick);
// Games keep their own proportions: each row's columns follow the images'
// aspect ratios, so a row shares one height without cropping or bars.
const gameRows = [t.games.slice(0, 2), t.games.slice(2, 4)];

const githubMark = 'M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z';

const icons: Record<string, string> = {
  blocks: '<rect x="3" y="4" width="6" height="16" rx="2"/><rect x="11" y="4" width="10" height="7" rx="2"/><rect x="11" y="13" width="10" height="7" rx="2"/>',
  cascade: '<path d="m12 3 9 4.5-9 4.5-9-4.5L12 3Z"/><path d="m3 12 9 4.5 9-4.5"/><path d="m3 16.5 9 4.5 9-4.5"/>',
  layout: '<rect x="3" y="3" width="18" height="18" rx="2.5"/><path d="M3 9h18M10 9v12"/>',
  bolt: '<path d="M13 2 4.5 13.5H12L11 22l8.5-11.5H12L13 2Z"/>',
};
---
<!doctype html>
<html lang={t.lang} data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{t.title} · {t.manualTitle}</title>
  <meta name="description" content={t.description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" hreflang="en" href="https://etaf.top/" />
  <link rel="alternate" hreflang="zh-CN" href="https://etaf.top/zh-cn/" />
  <meta property="og:title" content={t.title} />
  <meta property="og:description" content={t.description} />
  <meta property="og:image" content={`https://etaf.top${heroFront.image}`} />
  <script is:inline>
    (() => {
      const stored = localStorage.getItem('starlight-theme');
      const theme = stored === 'light' || stored === 'dark' ? stored
        : matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      document.documentElement.dataset.theme = theme;
    })();
  </script>
</head>
<body>
  <header class="nav">
    <div class="wrap nav-row">
      <a class="brand" href={t.base}>
        <img src={mark.src} alt="" width="28" height="28" />
        <span>ETAF</span>
      </a>
      <nav class="nav-links">
        <a class="hide-sm" href="#apps">{t.nav.apps}</a>
        <a class="hide-sm" href="#games">{t.nav.games}</a>
        <a href={`${t.base}introduction/`}>{t.nav.manual}</a>
        <a href={t.other.href} class="lang">{t.other.label}</a>
        <button class="icon-btn" type="button" data-theme-toggle aria-label={t.theme} title={t.theme}>
          <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"/></svg>
        </button>
        <a class="icon-btn" href={t.github} aria-label="GitHub" title="GitHub">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="fill"><path d={githubMark} /></svg>
        </a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="wrap hero-copy">
        <img class="hero-mark" src={mark.src} alt="ETAF" width="76" height="76" />
        <h1>{t.headline}</h1>
        <p class="tagline">{t.tagline}</p>
        <div class="actions">
          <a class="btn primary" href={`${t.base}introduction/`}>
            {t.read}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a class="btn ghost" href={t.github}>
            <svg viewBox="0 0 24 24" aria-hidden="true" class="fill"><path d={githubMark} /></svg>
            GitHub
          </a>
        </div>
      </div>

      <div class="wrap stage" aria-hidden="true">
        <div class="window back left"><div class="bar"><i></i><i></i><i></i><span>{heroLeft.name}</span></div><img src={heroLeft.image} alt="" width="1550" height="990" /></div>
        <div class="window back right"><div class="bar"><i></i><i></i><i></i><span>{heroRight.name}</span></div><img src={heroRight.image} alt="" width="1550" height="990" /></div>
        <div class="window front"><div class="bar"><i></i><i></i><i></i><span>{heroFront.name}</span></div><img src={heroFront.image} alt="" width="1550" height="990" fetchpriority="high" /></div>
      </div>
    </section>

    <section class="wrap features">
      {t.features.map((feature) => (
        <article class="feature">
          <span class="chip"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[feature.icon]} /></span>
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </article>
      ))}
    </section>

    <section class="wrap showcase" id="apps">
      <header class="section-head">
        <span class="eyebrow">{t.applications}</span>
        <h2>{t.built}</h2>
      </header>
      <div class="gallery apps">
        {t.apps.map((shot) => (
          <figure class="shot">
            <a class="shot-frame" href={shot.image} data-lightbox>
              <img src={shot.image} alt={shot.alt} loading="lazy" width="1550" height="990" />
            </a>
            <figcaption>
              <a class="repo" href={shot.href}>{shot.name}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg></a>
              <span>{shot.caption}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="wrap showcase" id="games">
      <header class="section-head">
        <span class="eyebrow">{t.gamesTitle}</span>
      </header>
      <div class="games">
        {gameRows.map((row) => (
          <div class="game-row" style={`grid-template-columns: ${row.map((g) => `${(g.width / g.height).toFixed(3)}fr`).join(' ')}`}>
            {row.map((shot) => (
              <figure class="shot">
                <a class="shot-frame" href={shot.image} data-lightbox>
                  <img src={shot.image} alt={shot.alt} loading="lazy" width={shot.width} height={shot.height} style={`aspect-ratio: ${shot.width} / ${shot.height}`} />
                </a>
                <figcaption>
                  <a class="repo" href={shot.href}>{shot.name}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg></a>
                  <span>{shot.caption}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        ))}
      </div>
    </section>

    <section class="wrap manual">
      <div class="manual-card">
        <div class="manual-copy">
          <h2>{t.manualTitle}</h2>
          <p>{t.manualLead}</p>
        </div>
        <ul class="guide">
          {t.guide.map((item) => (
            <li><a href={item.href}><span>{item.label}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <footer class="wrap"><div class="footer">
    <a class="brand small" href={t.base}><img src={mark.src} alt="" width="20" height="20" /><span>ETAF</span></a>
    <nav>
      <a href={`${t.base}introduction/`}>{t.nav.manual}</a>
      <a href={t.github}>GitHub</a>
      <a href={t.other.href}>{t.other.label}</a>
    </nav>
  </div></footer>

  <div class="lightbox" hidden data-lightbox-view>
    <button class="icon-btn close" type="button" aria-label={t.close} title={t.close}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
    <img alt="" />
  </div>

  <script is:inline>
    (() => {
      const root = document.documentElement;
      document.querySelector('[data-theme-toggle]').addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('starlight-theme', next);
      });

      // Screenshots open full size in an overlay; without JavaScript the
      // links open the WebP itself.
      const view = document.querySelector('[data-lightbox-view]');
      const image = view.querySelector('img');
      const close = () => { view.hidden = true; root.style.removeProperty('overflow'); };
      document.addEventListener('click', (event) => {
        const link = event.target.closest('a[data-lightbox]');
        if (!link) return;
        event.preventDefault();
        image.src = link.getAttribute('href');
        image.alt = link.querySelector('img').alt;
        view.hidden = false;
        root.style.overflow = 'hidden';
      });
      view.addEventListener('click', close);
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') close(); });
    })();
  </script>
</body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #09090d;
    --bg-soft: #0f0f15;
    --surface: #13131b;
    --surface-2: #181822;
    --line: rgb(255 255 255 / 0.08);
    --line-strong: rgb(255 255 255 / 0.14);
    --text: #f2f2f7;
    --muted: #a0a0b2;
    --faint: #6e6e80;
    --accent: #a78bfa;
    --accent-strong: #8b5cf6;
    --accent-ink: #ffffff;
    --chip: rgb(167 139 250 / 0.12);
    --glow-a: rgb(139 92 246 / 0.35);
    --glow-b: rgb(56 130 246 / 0.18);
    --shadow: 0 30px 80px -30px rgb(0 0 0 / 0.75), 0 0 0 1px var(--line);
    --frame-bar: #1b1b25;
    --font: -apple-system, BlinkMacSystemFont, "Segoe UI", "Inter", Roboto,
      "Helvetica Neue", Arial, "PingFang SC", "Hiragino Sans GB",
      "Microsoft YaHei", sans-serif;
    --mono: ui-monospace, "SF Mono", SFMono-Regular, "JetBrains Mono", Menlo,
      Consolas, monospace;
  }

  :root[data-theme='light'] {
    color-scheme: light;
    --bg: #fbfbfd;
    --bg-soft: #f4f4f8;
    --surface: #ffffff;
    --surface-2: #f6f6fa;
    --line: rgb(16 16 40 / 0.08);
    --line-strong: rgb(16 16 40 / 0.14);
    --text: #0c0c14;
    --muted: #55556a;
    --faint: #8a8a9c;
    --accent: #6d28d9;
    --accent-strong: #6d28d9;
    --chip: rgb(109 40 217 / 0.08);
    --glow-a: rgb(139 92 246 / 0.22);
    --glow-b: rgb(56 130 246 / 0.12);
    --shadow: 0 30px 70px -35px rgb(30 20 70 / 0.35), 0 0 0 1px var(--line);
    --frame-bar: #ececf2;
  }

  *, *::before, *::after { box-sizing: border-box; }

  html {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: clip;
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
    text-rendering: optimizeLegibility;
  }

  body { margin: 0; line-height: 1.6; font-size: 16px; }
  img { display: block; max-width: 100%; }
  a { color: inherit; text-decoration: none; }
  svg { width: 1.1em; height: 1.1em; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: none; }
  svg.fill { fill: currentColor; stroke: none; }

  .wrap { margin-inline: auto; max-width: 1180px; padding-inline: clamp(1.25rem, 4vw, 2rem); }

  /* Navigation */
  .nav {
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .nav-row { align-items: center; display: flex; height: 60px; justify-content: space-between; }
  .brand { align-items: center; display: inline-flex; font-weight: 650; gap: 0.6rem; letter-spacing: -0.01em; font-size: 1.05rem; }
  .brand img { border-radius: 7px; }
  .brand.small { font-size: 0.95rem; gap: 0.5rem; }
  .brand.small img { border-radius: 5px; }
  .nav-links { align-items: center; display: flex; gap: 0.25rem; }
  .nav-links > a:not(.icon-btn) {
    border-radius: 8px; color: var(--muted); font-size: 0.9rem; padding: 0.4rem 0.7rem;
    transition: color 0.15s, background 0.15s;
  }
  .nav-links > a:not(.icon-btn):hover { background: var(--chip); color: var(--text); }
  .icon-btn {
    align-items: center; background: none; border: 0; border-radius: 8px; color: var(--muted);
    cursor: pointer; display: inline-flex; height: 36px; justify-content: center; width: 36px;
    transition: color 0.15s, background 0.15s; font: inherit;
  }
  .icon-btn:hover { background: var(--chip); color: var(--text); }
  .icon-btn svg { height: 18px; width: 18px; }
  :root[data-theme='dark'] .icon-btn .sun, :root[data-theme='light'] .icon-btn .moon { display: none; }

  /* Hero */
  .hero { padding-top: clamp(3.5rem, 9vw, 6.5rem); position: relative; }
  .hero-glow {
    background:
      radial-gradient(40% 55% at 50% 0%, var(--glow-a), transparent 70%),
      radial-gradient(30% 40% at 78% 18%, var(--glow-b), transparent 70%),
      radial-gradient(30% 40% at 22% 22%, var(--glow-b), transparent 70%);
    inset: 0 0 auto;
    height: 900px;
    pointer-events: none;
    position: absolute;
    z-index: -1;
  }
  .hero-glow::after {
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 56px 56px;
    content: '';
    inset: 0;
    mask-image: radial-gradient(60% 55% at 50% 10%, #000, transparent 75%);
    -webkit-mask-image: radial-gradient(60% 55% at 50% 10%, #000, transparent 75%);
    position: absolute;
  }
  .hero-copy { align-items: center; display: flex; flex-direction: column; text-align: center; }
  .hero-mark { border-radius: 18px; box-shadow: 0 18px 50px -12px var(--glow-a); margin-bottom: 1.75rem; }
  .hero h1 {
    background: linear-gradient(180deg, var(--text) 30%, color-mix(in srgb, var(--text) 62%, var(--accent)));
    -webkit-background-clip: text; background-clip: text; color: transparent;
    font-size: clamp(2.35rem, 6.2vw, 4.4rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0;
    max-width: 15ch;
    text-wrap: balance;
  }
  :lang(zh-CN) .hero h1 { letter-spacing: -0.02em; max-width: 14em; line-height: 1.15; }
  .tagline {
    color: var(--muted);
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    line-height: 1.6;
    margin: 1.4rem 0 0;
    max-width: 38rem;
    text-wrap: balance;
  }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-top: 2.25rem; }
  .btn {
    align-items: center; border-radius: 999px; display: inline-flex; font-size: 0.95rem; font-weight: 600;
    gap: 0.5rem; height: 46px; padding-inline: 1.4rem; transition: transform 0.15s, box-shadow 0.15s, background 0.15s, border-color 0.15s;
  }
  .btn svg { height: 17px; width: 17px; }
  .btn.primary {
    background: linear-gradient(180deg, #9d78fb, #7c3aed);
    box-shadow: 0 10px 30px -10px rgb(124 58 237 / 0.8), inset 0 1px 0 rgb(255 255 255 / 0.25);
    color: #fff;
  }
  .btn.primary:hover { transform: translateY(-1px); box-shadow: 0 14px 36px -10px rgb(124 58 237 / 0.9), inset 0 1px 0 rgb(255 255 255 / 0.25); }
  .btn.primary:hover svg { transform: translateX(2px); }
  .btn.primary svg { transition: transform 0.15s; }
  .btn.ghost { background: var(--surface); border: 1px solid var(--line-strong); color: var(--text); }
  .btn.ghost:hover { border-color: var(--accent); transform: translateY(-1px); }

  /* Stage: three application windows */
  .stage {
    display: grid;
    margin-top: clamp(3rem, 7vw, 4.5rem);
    mask-image: linear-gradient(#000 70%, transparent);
    -webkit-mask-image: linear-gradient(#000 70%, transparent);
    perspective: 2000px;
  }
  .window {
    background: var(--surface);
    border-radius: 12px;
    box-shadow: var(--shadow);
    grid-area: 1 / 1;
    overflow: hidden;
  }
  .window .bar { align-items: center; background: var(--frame-bar); display: flex; gap: 6px; height: 30px; padding-inline: 12px; }
  .window .bar i { background: var(--line-strong); border-radius: 50%; height: 10px; width: 10px; }
  .window .bar i:nth-child(1) { background: #ff5f57; }
  .window .bar i:nth-child(2) { background: #febc2e; }
  .window .bar i:nth-child(3) { background: #28c840; }
  .window .bar span { color: var(--faint); flex: 1; font-family: var(--mono); font-size: 0.72rem; margin-right: 42px; text-align: center; }
  .window img { aspect-ratio: 3100 / 1980; height: auto; object-fit: cover; width: 100%; }
  .window.front { justify-self: center; position: relative; width: min(100%, 880px); z-index: 2; }
  .window.back { align-self: start; opacity: 0.85; width: min(60%, 580px); }
  .window.left { justify-self: start; transform: translateY(2.5rem) rotateY(14deg); transform-origin: left; }
  .window.right { justify-self: end; transform: translateY(2.5rem) rotateY(-14deg); transform-origin: right; }

  /* Features */
  .features {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(1rem, 3vw, 2rem);
    position: relative;
  }
  .feature {
    background: linear-gradient(180deg, var(--surface), var(--bg-soft));
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 1.5rem;
    transition: border-color 0.2s, transform 0.2s;
  }
  .feature:hover { border-color: var(--line-strong); transform: translateY(-2px); }
  .chip {
    align-items: center; background: var(--chip); border-radius: 10px; color: var(--accent);
    display: inline-flex; height: 40px; justify-content: center; width: 40px;
  }
  .chip svg { height: 20px; width: 20px; }
  .feature h3 { font-size: 1.02rem; font-weight: 650; letter-spacing: -0.01em; margin: 1.1rem 0 0.45rem; }
  .feature p { color: var(--muted); font-size: 0.92rem; line-height: 1.6; margin: 0; }

  /* Showcase */
  .showcase { margin-top: clamp(5rem, 11vw, 8rem); }
  #games { margin-top: clamp(3.5rem, 7vw, 5rem); }
  .section-head { margin-bottom: 2rem; }
  .eyebrow {
    color: var(--accent); font-family: var(--mono); font-size: 0.78rem; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase;
  }
  .section-head h2, .manual h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.6rem); font-weight: 700; letter-spacing: -0.035em;
    line-height: 1.1; margin: 0.6rem 0 0;
  }
  :lang(zh-CN) :is(.section-head h2, .manual h2) { letter-spacing: -0.01em; }
  .gallery { display: grid; gap: 2.25rem 1.5rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .gallery.apps .shot:first-child { grid-column: 1 / -1; }
  .games { display: grid; gap: 2.25rem; }
  .game-row { display: grid; gap: 1.5rem; align-items: start; }
  .shot { margin: 0; }
  .shot-frame {
    background: var(--surface);
    border-radius: 14px;
    box-shadow: var(--shadow);
    display: block;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .shot-frame img { aspect-ratio: 3100 / 1980; height: auto; object-fit: cover; transition: transform 0.5s ease; width: 100%; }
  .shot-frame:hover { transform: translateY(-3px); box-shadow: 0 36px 80px -30px var(--glow-a), 0 0 0 1px var(--line-strong); }
  .shot-frame:hover img { transform: scale(1.015); }
  .shot figcaption { align-items: baseline; display: flex; flex-wrap: wrap; gap: 0.3rem 0.75rem; margin-top: 1rem; padding-inline: 0.15rem; }
  .shot .repo {
    align-items: center; color: var(--text); display: inline-flex; font-family: var(--mono);
    font-size: 0.88rem; font-weight: 600; gap: 0.3rem;
  }
  .shot .repo svg { color: var(--faint); height: 14px; transition: color 0.15s, transform 0.15s; width: 14px; }
  .shot .repo:hover { color: var(--accent); }
  .shot .repo:hover svg { color: var(--accent); transform: translate(1px, -1px); }
  .shot figcaption span { color: var(--muted); font-size: 0.92rem; }

  /* Manual */
  .manual { margin-top: clamp(5rem, 11vw, 8rem); }
  .manual-card {
    background:
      radial-gradient(60% 120% at 100% 0%, var(--chip), transparent 70%),
      var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    display: grid;
