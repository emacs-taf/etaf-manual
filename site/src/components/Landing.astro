---
// The ETAF landing page.  It is a standalone page rather than a Starlight
// splash: the manual keeps Starlight's reading layout, while the landing owns
// its whole design.  Faces and palette come from brand.css, shared with the
// manual, and the colour theme follows the manual's stored choice
// (`starlight-theme`), so switching on either side carries over.
import '../styles/brand.css';
import { landing } from '../data/landing.mjs';
import mark from '../assets/etaf-icon.svg';

interface Props { language: 'en' | 'zh' }
const { language } = Astro.props;
const t = landing(language);
const hero = t.apps.find((app) => app.name === 'etaf-ncm')!;
// Games keep their own proportions: each row's columns follow the images'
// aspect ratios, so a row shares one height without cropping or bars.
const gameRows = [t.games.slice(0, 2), t.games.slice(2, 4)];
const githubMark = 'M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z';
const wenkai = 'https://cdn.jsdelivr.net/npm/lxgw-wenkai-webfont@1.7.0';
const number = (index: number) => String(index + 1).padStart(2, '0');
---
<!doctype html>
<html lang={t.lang} data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{t.title} — {t.gloss || t.fullName}</title>
  <meta name="description" content={t.description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" hreflang="en" href="https://etaf.top/" />
  <link rel="alternate" hreflang="zh-CN" href="https://etaf.top/zh-cn/" />
  <meta property="og:title" content={`${t.title} — ${t.fullName}`} />
  <meta property="og:description" content={t.description} />
  <meta property="og:image" content={`https://etaf.top${hero.image}`} />
  {t.lang === 'zh-CN' && <link rel="stylesheet" href={`${wenkai}/lxgwwenkai-regular.css`} />}
  <script is:inline>
    (() => {
      const stored = localStorage.getItem('starlight-theme');
      const theme = stored === 'light' || stored === 'dark' ? stored
        : matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      document.documentElement.dataset.theme = theme;
    })();
  </script>
</head>
<body>
  <header class="nav">
    <div class="wrap nav-row">
      <a class="brand" href={t.base}>
        <img src={mark.src} alt="" width="26" height="26" />
        <span>ETAF</span>
      </a>
      <nav class="nav-links">
        <a class="hide-sm" href="#apps">{t.nav.apps}</a>
        <a class="hide-sm" href="#games">{t.nav.games}</a>
        <a href={`${t.base}introduction/`}>{t.nav.manual}</a>
        <a href={t.other.href}>{t.other.label}</a>
        <button class="icon-btn" type="button" data-theme-toggle aria-label={t.theme} title={t.theme}>
          <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"/></svg>
        </button>
        <a class="icon-btn" href={t.github} aria-label="GitHub" title="GitHub">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="fill"><path d={githubMark} /></svg>
        </a>
      </nav>
    </div>
  </header>

  <main>
    <section class="wrap hero">
      <div class="hero-id">
        <img src={mark.src} alt="" width="52" height="52" />
        <p>
          <span class="acronym">ETAF</span>
          <span class="full-name">{t.fullName}{t.gloss && <span class="gloss">{t.gloss}</span>}</span>
        </p>
      </div>
      <h1>{t.headline}</h1>
      <div class="hero-side">
      <p class="tagline">{t.tagline}</p>
      <div class="actions">
        <a class="btn" href={t.install.href}>{t.install.label}<span aria-hidden="true">→</span></a>
        <a class="text-link" href={t.github}>GitHub<span aria-hidden="true">↗</span></a>
      </div>
      </div>
      <a class="hero-shot" href={hero.image} data-lightbox>
        <img src={hero.image} alt={hero.alt} width={hero.width} height={hero.height} fetchpriority="high" />
      </a>
    </section>

    <section class="wrap features">
      {t.features.map((feature, index) => (
        <article class="feature">
          <span class="index">{number(index)}</span>
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </article>
      ))}
    </section>

    <section class="wrap showcase" id="apps">
      <header class="section-head">
        <span class="eyebrow">{t.applications}</span>
        <h2>{t.built}</h2>
      </header>
      <div class="gallery">
        {t.apps.map((shot) => (
          <figure class="shot">
            <a class="frame" href={shot.image} data-lightbox>
              <img src={shot.image} alt={shot.alt} loading="lazy" width={shot.width} height={shot.height} />
            </a>
            <figcaption>
              <a class="repo" href={shot.href}>{shot.name}<span aria-hidden="true">↗</span></a>
              <span>{shot.caption}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="wrap showcase" id="games">
      <header class="section-head">
        <span class="eyebrow">{t.gamesTitle}</span>
      </header>
      <div class="games">
        {gameRows.map((row) => (
          <div class="game-row" style={`grid-template-columns: ${row.map((g) => `${(g.width / g.height).toFixed(3)}fr`).join(' ')}`}>
            {row.map((shot) => (
              <figure class="shot">
                <a class="frame" href={shot.image} data-lightbox>
                  <img src={shot.image} alt={shot.alt} loading="lazy" width={shot.width} height={shot.height} />
                </a>
                <figcaption>
                  <a class="repo" href={shot.href}>{shot.name}<span aria-hidden="true">↗</span></a>
                  <span>{shot.caption}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        ))}
      </div>
    </section>

    <section class="wrap"><div class="manual">
      <div class="manual-copy">
        <h2>{t.manualTitle}</h2>
        <p>{t.manualLead}</p>
      </div>
      <ol class="guide">
        {t.guide.map((item) => (
          <li><a href={item.href}><span>{item.label}</span><span class="arrow" aria-hidden="true">→</span></a></li>
        ))}
      </ol>
    </div></section>
  </main>

  <footer class="wrap"><div class="footer">
    <a class="brand small" href={t.base}><img src={mark.src} alt="" width="20" height="20" /><span>ETAF</span></a>
    <nav>
      <a href={`${t.base}introduction/`}>{t.nav.manual}</a>
      <a href={t.github}>GitHub</a>
      <a href={t.other.href}>{t.other.label}</a>
    </nav>
  </div></footer>

  <div class="lightbox" hidden data-lightbox-view>
    <button class="icon-btn close" type="button" aria-label={t.close} title={t.close}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
    <img alt="" />
  </div>

  <script is:inline>
    (() => {
      const root = document.documentElement;
      document.querySelector('[data-theme-toggle]').addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('starlight-theme', next);
      });

      // Screenshots open full size in an overlay; without JavaScript the
      // links open the WebP itself.
      const view = document.querySelector('[data-lightbox-view]');
      const image = view.querySelector('img');
      const close = () => { view.hidden = true; root.style.removeProperty('overflow'); };
      document.addEventListener('click', (event) => {
        const link = event.target.closest('a[data-lightbox]');
        if (!link) return;
        event.preventDefault();
        image.src = link.getAttribute('href');
        image.alt = link.querySelector('img').alt;
        view.hidden = false;
        root.style.overflow = 'hidden';
      });
      view.addEventListener('click', close);
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') close(); });
    })();
  </script>
</body>
</html>

<style is:global>
  :root { color-scheme: dark; }
  :root[data-theme='light'] { color-scheme: light; }

  *, *::before, *::after { box-sizing: border-box; }

  html {
    background-color: var(--etaf-paper);
    background-image: var(--etaf-grain);
    background-size: 160px 160px;
    color: var(--etaf-ink-2);
    font-family: var(--etaf-font-text);
    font-optical-sizing: auto;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: clip;
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
    text-rendering: optimizeLegibility;
  }

  body { font-size: 18px; line-height: 1.65; margin: 0; }
  :lang(zh-CN) body { line-height: 1.8; }
  img { display: block; max-width: 100%; }
  a { color: inherit; text-decoration: none; }
  svg { fill: none; flex: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.6; }
  svg.fill { fill: currentColor; stroke: none; }
  ::selection { background: var(--etaf-accent-soft); color: var(--etaf-ink); }

  .wrap { margin-inline: auto; max-width: 1160px; padding-inline: clamp(1.25rem, 4vw, 2.5rem); }

  /* Labels, navigation and repository names are set in mono. */
  .nav-links, .btn, .text-link, .eyebrow, .index, .repo, .footer nav {
    font-family: var(--etaf-font-mono);
  }

  /* Navigation */
  .nav {
    background-color: var(--etaf-paper);
    background-image: var(--etaf-grain);
    background-size: 160px 160px;
    border-bottom: 1px solid var(--etaf-rule);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .nav-row { align-items: center; display: flex; height: 64px; justify-content: space-between; }
  .brand {
    align-items: center; color: var(--etaf-ink); display: inline-flex;
    font-family: var(--etaf-font-display); font-size: 1.3rem; font-weight: 600; gap: 0.6rem; letter-spacing: -0.01em;
  }
  .brand img { border-radius: 6px; }
  .brand.small { font-size: 1.05rem; gap: 0.5rem; }
  .brand.small img { border-radius: 4px; }
  .nav-links { align-items: center; display: flex; font-size: 0.8125rem; gap: 1.6rem; }
  .nav-links > a:not(.icon-btn) { color: var(--etaf-ink-3); transition: color 0.15s; }
  .nav-links > a:not(.icon-btn):hover { color: var(--etaf-ink); }
  .icon-btn {
    align-items: center; background: none; border: 0; color: var(--etaf-ink-3); cursor: pointer;
    display: inline-flex; height: 32px; justify-content: center; margin-inline: -0.5rem; padding: 0; width: 32px;
    transition: color 0.15s;
  }
  .icon-btn:hover { color: var(--etaf-ink); }
  .icon-btn svg { height: 17px; width: 17px; }
  :root[data-theme='dark'] .icon-btn .sun, :root[data-theme='light'] .icon-btn .moon { display: none; }

  /* Hero: a book-like title block above one large screenshot. */
  .hero {
    column-gap: 4rem;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    padding-top: clamp(4rem, 10vw, 7.5rem);
  }
  .hero > :not(.hero-side) { grid-column: 1 / -1; }
  .hero > h1 { grid-column: 1; grid-row: 2; }
  .hero-side { align-self: end; grid-column: 2; grid-row: 2; padding-bottom: 0.6rem; }
  .hero-side .tagline { margin-top: 0; }
  .hero-id { align-items: center; display: flex; gap: 1rem; margin-bottom: 2.5rem; }
  .hero-id img { border-radius: 12px; }
  .hero-id p { display: grid; gap: 0.2rem; margin: 0; }
  .acronym {
    color: var(--etaf-ink); font-family: var(--etaf-font-display); font-size: 1.35rem; font-weight: 600;
    letter-spacing: 0.02em; line-height: 1.2;
  }
  .full-name {
    color: var(--etaf-ink-3); display: grid; font-family: var(--etaf-font-mono);
    font-size: 0.8125rem; letter-spacing: 0.04em; line-height: 1.5;
  }
  .gloss { font-family: var(--etaf-font-text); letter-spacing: 0.08em; }
  .hero h1 {
    color: var(--etaf-ink);
    font-family: var(--etaf-font-display);
    font-size: clamp(2.5rem, 6vw, 4.75rem);
    font-weight: 500;
    letter-spacing: -0.028em;
    line-height: 1.04;
    margin: 0;
    max-width: 15ch;
    text-wrap: balance;
  }
  :lang(zh-CN) .hero h1 { font-weight: 600; letter-spacing: 0.01em; line-height: 1.2; max-width: 11em; }
  .tagline {
    color: var(--etaf-ink-2);
    font-size: clamp(1.15rem, 1.9vw, 1.4rem);
    font-style: italic;
    line-height: 1.5;
    margin: 1.5rem 0 0;
    max-width: 34rem;
    text-wrap: pretty;
  }
  :lang(zh-CN) .tagline { font-style: normal; }
  .actions { align-items: center; display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-top: 2.5rem; }
  .btn {
    align-items: center; background: var(--etaf-ink); border-radius: 4px; color: var(--etaf-paper);
    display: inline-flex; font-size: 0.875rem; font-weight: 500; gap: 0.75rem; height: 46px;
    padding-inline: 1.35rem; transition: background 0.15s;
  }
  .btn:hover { background: var(--etaf-accent); }
  .btn span, .text-link span, .repo span, .guide .arrow { transition: transform 0.15s; }
  .btn:hover span { transform: translateX(3px); }
  .text-link {
    border-bottom: 1px solid var(--etaf-rule-strong); color: var(--etaf-ink); display: inline-flex;
    font-size: 0.875rem; gap: 0.4rem; padding-bottom: 2px; transition: border-color 0.15s;
  }
  .text-link:hover { border-color: var(--etaf-ink); }
  .text-link:hover span { transform: translate(2px, -2px); }

  .hero-shot, .frame {
    background: var(--etaf-paper-2);
    border: 1px solid var(--etaf-rule);
    border-radius: 6px;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06), 0 24px 48px -32px rgb(0 0 0 / 0.45);
    display: block;
    overflow: hidden;
    transition: border-color 0.2s;
  }
  .hero-shot { margin-top: clamp(3.5rem, 7vw, 5rem); }
  .hero-shot:hover, .frame:hover { border-color: var(--etaf-rule-strong); }
  .hero-shot img, .frame img { height: auto; width: 100%; }

  /* Features: four columns under one rule, numbered like sections. */
  .features {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(4.5rem, 9vw, 7rem);
  }
  .feature { border-top: 1px solid var(--etaf-rule-strong); padding-top: 1.25rem; }
  .index { color: var(--etaf-accent); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.08em; }
  .feature h3 {
    color: var(--etaf-ink); font-family: var(--etaf-font-display); font-size: 1.3rem; font-weight: 600;
    letter-spacing: -0.01em; line-height: 1.25; margin: 0.75rem 0 0.6rem;
  }
  .feature p { color: var(--etaf-ink-3); font-size: 1rem; line-height: 1.6; margin: 0; }
  :lang(zh-CN) .feature p { line-height: 1.8; }

  /* Showcase */
  .showcase { margin-top: clamp(6rem, 12vw, 9rem); }
  #games { margin-top: clamp(4rem, 8vw, 6rem); }
  .section-head { border-top: 1px solid var(--etaf-rule-strong); margin-bottom: 2.5rem; padding-top: 1.25rem; }
  .eyebrow { color: var(--etaf-ink-3); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; }
  .section-head h2, .manual h2 {
    color: var(--etaf-ink); font-family: var(--etaf-font-display); font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500; letter-spacing: -0.022em; line-height: 1.1; margin: 0.9rem 0 0;
  }
  :lang(zh-CN) :is(.section-head h2, .manual h2) { font-weight: 600; letter-spacing: 0.01em; }
  .gallery { display: grid; gap: 3rem 2rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .gallery .shot:first-child { grid-column: 1 / -1; }
  .games { display: grid; gap: 3rem; }
  .game-row { align-items: start; display: grid; gap: 2rem; }
  .shot { margin: 0; }
  .shot figcaption { align-items: baseline; display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; margin-top: 1rem; }
  .repo { color: var(--etaf-ink); display: inline-flex; font-size: 0.8125rem; font-weight: 500; gap: 0.35rem; }
  .repo span { color: var(--etaf-ink-3); }
  .repo:hover { color: var(--etaf-accent); }
  .repo:hover span { color: var(--etaf-accent); transform: translate(2px, -2px); }
  .shot figcaption > span { color: var(--etaf-ink-3); font-size: 1rem; font-style: italic; }
  :lang(zh-CN) .shot figcaption > span { font-style: normal; }

  /* Manual: a table of contents rather than a card. */
  .manual {
    border-top: 1px solid var(--etaf-rule-strong);
    display: grid;
    gap: 3rem;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    margin-top: clamp(6rem, 12vw, 9rem);
    padding-top: 1.25rem;
  }
  .manual h2 { margin-top: 0; }
  .manual-copy p { color: var(--etaf-ink-2); font-size: 1.125rem; line-height: 1.65; margin: 1.25rem 0 0; max-width: 30rem; }
  :lang(zh-CN) .manual-copy p { line-height: 1.85; }
  .guide { counter-reset: guide; list-style: none; margin: 0; padding: 0; }
  .guide li { border-bottom: 1px solid var(--etaf-rule); counter-increment: guide; }
  .guide li:first-child { border-top: 1px solid var(--etaf-rule); }
  .guide a {
    align-items: baseline; color: var(--etaf-ink); display: flex; font-family: var(--etaf-font-display);
    font-size: 1.25rem; gap: 1.25rem; padding: 0.95rem 0; transition: color 0.15s;
  }
  .guide a::before {
    color: var(--etaf-ink-3); content: counter(guide, decimal-leading-zero); font-family: var(--etaf-font-mono);
    font-size: 0.75rem; letter-spacing: 0.08em;
  }
  .guide .arrow { color: var(--etaf-ink-3); font-family: var(--etaf-font-mono); font-size: 0.9rem; margin-left: auto; }
  .guide a:hover { color: var(--etaf-accent); }
  .guide a:hover .arrow { color: var(--etaf-accent); transform: translateX(4px); }

  /* Footer */
  .footer {
    align-items: center; border-top: 1px solid var(--etaf-rule); display: flex; flex-wrap: wrap;
    gap: 1rem; justify-content: space-between; margin-top: clamp(5rem, 10vw, 8rem); padding-block: 2rem 2.75rem;
  }
  .footer .brand { color: var(--etaf-ink); }
  .footer nav { display: flex; flex-wrap: wrap; font-size: 0.8125rem; gap: 1.75rem; }
  .footer nav a { color: var(--etaf-ink-3); }
  .footer nav a:hover { color: var(--etaf-ink); }

  /* Lightbox */
  .lightbox {
    align-items: center; background: rgb(12 11 10 / 0.92); cursor: zoom-out; display: flex; inset: 0;
    justify-content: center; padding: 2rem; position: fixed; z-index: 50;
  }
  .lightbox[hidden] { display: none; }
  .lightbox img { border-radius: 4px; max-height: 100%; max-width: 100%; object-fit: contain; }
  .lightbox .close { color: #fff; margin: 0; position: absolute; right: 1rem; top: 1rem; }

  @media (max-width: 960px) {
    .hero { display: block; }
    .hero-side { padding-bottom: 0; }
    .hero-side .tagline { margin-top: 1.5rem; }
    .features { gap: 2rem 2.5rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .manual { grid-template-columns: 1fr; gap: 2rem; }
  }

  @media (max-width: 640px) {
    body { font-size: 17px; }
    .hide-sm { display: none; }
    .nav-row { height: 56px; }
    .nav-links { gap: 1.15rem; }
    .hero-id { gap: 0.85rem; margin-bottom: 2rem; }
    .hero-id img { border-radius: 10px; height: 44px; width: 44px; }
    .full-name { font-size: 0.75rem; letter-spacing: 0.02em; }
    .features { grid-template-columns: 1fr; gap: 1.75rem; }
    .gallery, .games { gap: 2.25rem; grid-template-columns: 1fr; }
    .game-row { gap: 2.25rem; grid-template-columns: 1fr !important; }
    .lightbox { padding: 0; }
    .lightbox img { border-radius: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; }
  }
</style>
